{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "functions": {
      "port": 5001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4401
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/og/**",
        "function": "og"
      },
      {
        "source": "/img/**",
        "function": "img"
      },
      {
        "source": "/s",
        "function": "simulator"
      },
      {
        "source": "/simulator{,/**}",
        "function": "simulator"
      },
      {
        "source": "/admin{,/**}",
        "destination": "/admin.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
