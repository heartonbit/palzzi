rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: only admins can read/write
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Patterns collection: anyone can read, only authenticated users can write own patterns
    match /patterns/{patternId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.ownerUid || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // User colors: each user reads/writes only their own document (keyed by uid)
    match /userColors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
