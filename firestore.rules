rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: only admins can read/write
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Patterns collection: anyone can read, only authenticated users can write own patterns
    match /patterns/{patternId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if
        // Owner or admin can update anything
        (request.auth != null && (
          request.auth.uid == resource.data.ownerUid || isAdmin()
        )) ||
        // Any user (including anonymous) may update only the likes count
        (
          request.resource.data.likes is number &&
          request.resource.data.likes >= 0 &&
          request.resource.data.templateId == resource.data.templateId &&
          request.resource.data.patternKey == resource.data.patternKey &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.colors == resource.data.colors &&
          request.resource.data.nThreads == resource.data.nThreads
        );
      allow delete: if request.auth != null && (request.auth.uid == resource.data.ownerUid || isAdmin());

      // Likes subcollection: authenticated users or anonymous session-based likes
      match /likes/{uid} {
        allow read: if true;
        allow write: if (request.auth != null && request.auth.uid == uid) ||
                      resource.data.sessionId == uid ||
                      request.resource.data.sessionId == uid;
      }
    }

    // User likes index: each user reads/writes only their own document
    match /userLikes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // User colors: each user reads/writes only their own document (keyed by uid)
    match /userColors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
