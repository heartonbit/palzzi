rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Patterns collection: anyone can read, only authenticated users can write own patterns
    match /patterns/{patternId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // User colors: each user reads/writes only their own document (keyed by uid)
    match /userColors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
